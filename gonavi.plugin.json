{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "autumnnazi.ssh",
  "name": "GoNavi SSH",
  "version": "0.1.1",
  "minHostVersion": "1.2.0",
  "description": "SSH terminal, SFTP file manager and agent tools with TOFU host keys and encrypted profiles.",
  "author": "AutumnNazi",
  "license": "MIT",
  "permissions": ["ai.tools", "host.log"],
  "permissionNotes": {
    "ai.tools": "Exposes ssh/sftp/agent commands to the GoNavi Agent tool catalog; write commands respect the plugin read-only switch.",
    "host.log": "Writes bounded startup and connection diagnostics."
  },
  "backend": {
    "platforms": {
      "windows/amd64": { "executable": "bin/gonavi-ssh-windows-amd64.exe" },
      "linux/amd64": { "executable": "bin/gonavi-ssh-linux-amd64" },
      "darwin/arm64": { "executable": "bin/gonavi-ssh-darwin-arm64" }
    }
  },
  "window": {
    "entry": "frontend/index.html",
    "title": "GoNavi SSH",
    "width": 1200,
    "height": 760
  },
  "contributes": {
    "commands": [
      { "id": "profile.list", "title": "List SSH profiles", "effect": "read", "inputSchema": { "type": "object", "additionalProperties": false } },
      { "id": "profile.save", "title": "Create or update an SSH profile (supports up to 3 proxy jumps)", "effect": "write",
        "inputSchema": { "type": "object", "required": ["profile"], "properties": { "profile": { "type": "object" } } } },
      { "id": "profile.delete", "title": "Delete an SSH profile", "effect": "write",
        "inputSchema": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "maxLength": 64 } } } },
      { "id": "profile.test", "title": "Test SSH connectivity (non-interactive)", "effect": "read",
        "inputSchema": { "type": "object", "properties": { "profileId": { "type": "string", "maxLength": 64 }, "profile": { "type": "object" } } } },
      { "id": "profile.importFromGonavi", "title": "Import SSH tunnel hosts from the GoNavi saved database connections (non-sensitive fields, idempotent)", "effect": "write",
        "inputSchema": { "type": "object", "additionalProperties": false } },
      { "id": "settings.get", "title": "Read plugin settings", "effect": "read", "inputSchema": { "type": "object", "additionalProperties": false } },
      { "id": "settings.set", "title": "Update plugin settings (read-only switch, sudo allowlist, quick commands)", "effect": "write",
        "inputSchema": { "type": "object", "required": ["settings"], "properties": { "settings": { "type": "object" } } } },
      { "id": "conn.open", "title": "Start opening an SSH connection; returns immediately, poll conn.status (state needInput awaits conn.answer for TOTP prompts)", "effect": "write",
        "inputSchema": { "type": "object", "required": ["profileId"], "properties": { "profileId": { "type": "string", "maxLength": 64 } } } },
      { "id": "conn.answer", "title": "Answer an interactive auth challenge", "effect": "write",
        "inputSchema": { "type": "object", "required": ["connectionId", "answers"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "answers": { "type": "array", "items": { "type": "string", "maxLength": 256 }, "maxItems": 8 } } } },
      { "id": "conn.cancel", "title": "Cancel a pending connection", "effect": "write",
        "inputSchema": { "type": "object", "required": ["connectionId"], "properties": { "connectionId": { "type": "string", "maxLength": 64 } } } },
      { "id": "conn.status", "title": "List connections with pending state and challenges", "effect": "read",
        "inputSchema": { "type": "object", "properties": { "connectionId": { "type": "string", "maxLength": 64 } } } },
      { "id": "conn.close", "title": "Close an SSH connection", "effect": "write",
        "inputSchema": { "type": "object", "required": ["connectionId"], "properties": { "connectionId": { "type": "string", "maxLength": 64 } } } },
      { "id": "session.teardown", "title": "Close all terminal sessions, transfers and SSH connections in this plugin process (host calls this when the plugin window closes)", "effect": "write",
        "inputSchema": { "type": "object", "additionalProperties": false } },
      { "id": "terminal.open", "title": "Open a PTY terminal session on a connection", "effect": "write",
        "inputSchema": { "type": "object", "required": ["connectionId"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "cols": { "type": "integer", "minimum": 2, "maximum": 1000 }, "rows": { "type": "integer", "minimum": 2, "maximum": 1000 } } } },
      { "id": "terminal.write", "title": "Write user input into a terminal session", "effect": "write",
        "inputSchema": { "type": "object", "required": ["sessionKey", "dataBase64"], "properties": { "sessionKey": { "type": "string", "maxLength": 64 }, "dataBase64": { "type": "string", "maxLength": 131072 } } } },
      { "id": "terminal.writeMulti", "title": "Broadcast input to multiple sessions (batch input)", "effect": "write",
        "inputSchema": { "type": "object", "required": ["sessionKeys", "dataBase64"], "properties": { "sessionKeys": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "maxItems": 16 }, "dataBase64": { "type": "string", "maxLength": 131072 } } } },
      { "id": "terminal.read", "title": "Long-poll terminal output (blocks up to 25s waiting for data)", "effect": "read",
        "inputSchema": { "type": "object", "required": ["sessionKey"], "properties": { "sessionKey": { "type": "string", "maxLength": 64 }, "maxBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }, "waitMillis": { "type": "integer", "minimum": 0, "maximum": 25000 } } } },
      { "id": "terminal.resize", "title": "Resize a terminal session", "effect": "write",
        "inputSchema": { "type": "object", "required": ["sessionKey", "cols", "rows"], "properties": { "sessionKey": { "type": "string", "maxLength": 64 }, "cols": { "type": "integer", "minimum": 2, "maximum": 1000 }, "rows": { "type": "integer", "minimum": 2, "maximum": 1000 } } } },
      { "id": "terminal.close", "title": "Close a terminal session", "effect": "write",
        "inputSchema": { "type": "object", "required": ["sessionKey"], "properties": { "sessionKey": { "type": "string", "maxLength": 64 } } } },
      { "id": "terminal.list", "title": "List terminal sessions", "effect": "read",
        "inputSchema": { "type": "object", "properties": { "connectionId": { "type": "string", "maxLength": 64 } } } },
      { "id": "terminal.history", "title": "Read command history of a session", "effect": "read",
        "inputSchema": { "type": "object", "required": ["sessionKey"], "properties": { "sessionKey": { "type": "string", "maxLength": 64 }, "limit": { "type": "integer", "minimum": 1, "maximum": 1000 } } } },
      { "id": "sftp.list", "title": "List a remote directory (paged, dirs first, sortable by name/size/mtime)", "effect": "read",
        "inputSchema": { "type": "object", "required": ["connectionId"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "path": { "type": "string", "maxLength": 1024 }, "offset": { "type": "integer", "minimum": 0 }, "limit": { "type": "integer", "minimum": 1, "maximum": 1000 }, "sortBy": { "type": "string", "enum": ["name", "size", "mtime"] } } } },
      { "id": "sftp.stat", "title": "Stat a remote path", "effect": "read",
        "inputSchema": { "type": "object", "required": ["connectionId", "path"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "path": { "type": "string", "maxLength": 1024 } } } },
      { "id": "sftp.pwd", "title": "Resolve a remote path to its canonical absolute path", "effect": "read",
        "inputSchema": { "type": "object", "required": ["connectionId"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "path": { "type": "string", "maxLength": 1024 } } } },
      { "id": "sftp.mkdir", "title": "Create a remote directory", "effect": "write",
        "inputSchema": { "type": "object", "required": ["connectionId", "path"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "path": { "type": "string", "maxLength": 1024 } } } },
      { "id": "sftp.rename", "title": "Rename or move a remote path", "effect": "write",
        "inputSchema": { "type": "object", "required": ["connectionId", "oldPath", "newPath"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "oldPath": { "type": "string", "maxLength": 1024 }, "newPath": { "type": "string", "maxLength": 1024 } } } },
      { "id": "sftp.copy", "title": "Copy a remote file server-side (streamed, never crosses the host bridge)", "effect": "write",
        "inputSchema": { "type": "object", "required": ["connectionId", "srcPath", "dstPath"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "srcPath": { "type": "string", "maxLength": 1024 }, "dstPath": { "type": "string", "maxLength": 1024 } } } },
      { "id": "sftp.chmod", "title": "Change remote file mode (octal)", "effect": "write",
        "inputSchema": { "type": "object", "required": ["connectionId", "path", "mode"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "path": { "type": "string", "maxLength": 1024 }, "mode": { "type": "string", "maxLength": 5 } } } },
      { "id": "sftp.remove", "title": "Remove a remote file", "effect": "write",
        "inputSchema": { "type": "object", "required": ["connectionId", "path"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "path": { "type": "string", "maxLength": 1024 } } } },
      { "id": "sftp.removeRecursive", "title": "Recursively remove a remote file or directory tree", "effect": "write",
        "inputSchema": { "type": "object", "required": ["connectionId", "path"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "path": { "type": "string", "maxLength": 1024 } } } },
      { "id": "sftp.preview", "title": "Read a small remote file (<=256KiB, base64)", "effect": "read",
        "inputSchema": { "type": "object", "required": ["connectionId", "path"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "path": { "type": "string", "maxLength": 1024 }, "maxBytes": { "type": "integer", "minimum": 1, "maximum": 262144 } } } },
      { "id": "sftp.writeFile", "title": "Write a small remote file (base64, <=256KiB); use transfers for large files", "effect": "write",
        "inputSchema": { "type": "object", "required": ["connectionId", "path", "dataBase64"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "path": { "type": "string", "maxLength": 1024 }, "dataBase64": { "type": "string", "maxLength": 358400 } } } },
      { "id": "sftp.du", "title": "Disk usage of a remote path (statvfs)", "effect": "read",
        "inputSchema": { "type": "object", "required": ["connectionId", "path"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "path": { "type": "string", "maxLength": 1024 } } } },
      { "id": "knownHosts.list", "title": "List trusted known-host entries (address, fingerprint, key type)", "effect": "read", "inputSchema": { "type": "object", "additionalProperties": false } },
      { "id": "knownHosts.remove", "title": "Remove a trusted known-host entry (re-record after server replacement)", "effect": "write",
        "inputSchema": { "type": "object", "required": ["addr"], "properties": { "addr": { "type": "string", "maxLength": 255 } } } },
      { "id": "fs.listLocal", "title": "List a local directory (plugin process filesystem access)", "effect": "read",
        "inputSchema": { "type": "object", "properties": { "path": { "type": "string", "maxLength": 1024 } } } },
      { "id": "transfer.start", "title": "Start a transfer: upload (local to remote), download (remote to local) or serverToServer (remote A to remote B via the plugin process)", "effect": "write",
        "inputSchema": { "type": "object", "required": ["connectionId", "direction"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "direction": { "type": "string", "enum": ["upload", "download", "serverToServer"] }, "remotePath": { "type": "string", "maxLength": 1024 }, "localPath": { "type": "string", "maxLength": 1024 }, "targetConnectionId": { "type": "string", "maxLength": 64 }, "targetPath": { "type": "string", "maxLength": 1024 } } } },
      { "id": "transfer.status", "title": "Query a transfer task (progress, rate, state)", "effect": "read",
        "inputSchema": { "type": "object", "required": ["taskId"], "properties": { "taskId": { "type": "string", "maxLength": 64 } } } },
      { "id": "transfer.list", "title": "List transfer tasks", "effect": "read", "inputSchema": { "type": "object", "additionalProperties": false } },
      { "id": "transfer.cancel", "title": "Cancel a running transfer", "effect": "write",
        "inputSchema": { "type": "object", "required": ["taskId"], "properties": { "taskId": { "type": "string", "maxLength": 64 } } } },
      { "id": "transfer.retry", "title": "Retry a failed or cancelled transfer with resume", "effect": "write",
        "inputSchema": { "type": "object", "required": ["taskId", "connectionId"], "properties": { "taskId": { "type": "string", "maxLength": 64 }, "connectionId": { "type": "string", "maxLength": 64 } } } },
      { "id": "agent.exec", "title": "Run a command on the server and return combined output (<=25s)", "effect": "write",
        "inputSchema": { "type": "object", "required": ["connectionId", "command"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "command": { "type": "string", "maxLength": 8192 }, "timeoutMillis": { "type": "integer", "minimum": 100, "maximum": 25000 }, "force": { "type": "boolean" } } } },
      { "id": "agent.execSudo", "title": "Run an allowlisted sudo command; injects the stored Quick Sudo password (with optional OTP) or falls back to sudo -n NOPASSWD", "effect": "write",
        "inputSchema": { "type": "object", "required": ["connectionId", "command"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "command": { "type": "string", "maxLength": 8192 }, "timeoutMillis": { "type": "integer", "minimum": 100, "maximum": 25000 } } } },
      { "id": "agent.execMulti", "title": "Run the same command on up to 10 hosts in parallel; results per host (read-only allowlist applies in read-only mode)", "effect": "write",
        "inputSchema": { "type": "object", "required": ["connectionIds", "command"], "properties": { "connectionIds": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "minItems": 1, "maxItems": 10 }, "command": { "type": "string", "maxLength": 8192 }, "timeoutMillis": { "type": "integer", "minimum": 100, "maximum": 20000 }, "force": { "type": "boolean" } } } },
      { "id": "agent.runBg", "title": "Start a long-running command in the background; returns taskId", "effect": "write",
        "inputSchema": { "type": "object", "required": ["connectionId", "command"], "properties": { "connectionId": { "type": "string", "maxLength": 64 }, "command": { "type": "string", "maxLength": 8192 } } } },
      { "id": "agent.taskStatus", "title": "Read background task output incrementally by byte offset", "effect": "read",
        "inputSchema": { "type": "object", "required": ["taskId"], "properties": { "taskId": { "type": "string", "maxLength": 64 }, "offset": { "type": "integer", "minimum": 0 } } } },
      { "id": "agent.taskCancel", "title": "Cancel a background task", "effect": "write",
        "inputSchema": { "type": "object", "required": ["taskId"], "properties": { "taskId": { "type": "string", "maxLength": 64 } } } },
      { "id": "agent.metrics", "title": "Collect host metrics (load, memory, disks)", "effect": "read",
        "inputSchema": { "type": "object", "required": ["connectionId"], "properties": { "connectionId": { "type": "string", "maxLength": 64 } } } },
      { "id": "agent.triage", "title": "Quick health triage (disk pressure, dmesg errors)", "effect": "read",
        "inputSchema": { "type": "object", "required": ["connectionId"], "properties": { "connectionId": { "type": "string", "maxLength": 64 } } } }
    ],
    "panels": [
      {
        "id": "ssh-status",
        "title": "SSH",
        "body": {
          "type": "text",
          "text": "GoNavi SSH：终端、SFTP 与 Agent 工具。打开 GoNavi SSH 窗口开始使用。"
        }
      }
    ]
  }
}
